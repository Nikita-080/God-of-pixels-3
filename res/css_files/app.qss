QWidget {
    background-color: rgb(0, 0, 0);
}
QLabel, QGroupBox, QRadioButton, QCheckBox {
    color: rgb(110, 170, 200);
    background-color: transparent;
}
QLabel:disabled, QGroupBox:disabled, QGroupBox::title:disabled, QRadioButton:disabled, QCheckBox:disabled {
    color: rgb(55, 75, 85);
}
QGroupBox:disabled {
    background-color: rgb(10, 10, 10);
}
QLineEdit:disabled {
    color: rgb(70, 95, 85);
    background-color: rgb(16, 16, 16);
    border-color: rgb(45, 65, 75);
}
QPushButton:disabled {
    color: rgb(55, 75, 85);
    background-color: rgb(12, 12, 12);
    border-color: rgb(45, 65, 75);
}
QSlider::groove:horizontal {
    height: 6px;
    background: rgb(50, 50, 50);
    border-radius: 3px;
}
QSlider::handle:horizontal,
QSlider::handle {
    background-color: rgb(0, 255, 0);
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    border: 1px solid rgb(0, 255, 127);
}
QSlider::add-page:horizontal,
QSlider::add-page {
    background: rgb(200, 200, 200);
    margin: 5px;
    margin-right: 0px;
}
QSlider::sub-page:horizontal,
QSlider::sub-page {
    background: rgb(0, 255, 0);
    margin: 5px;
    margin-left: 0px;
}
QSlider::handle:disabled {
    background-color: rgb(0, 170, 0);
    border-color: rgb(0, 170, 85);
}
QSlider::add-page:disabled {
    background: rgb(133, 133, 133);
}
QSlider::sub-page:disabled {
    background: rgb(0, 170, 0);
}
QMenuBar {
    background-color: rgb(18, 24, 30);
    color: rgb(110, 170, 200);
    border-bottom: 1px solid rgb(70, 100, 115);
    padding-bottom: 1px;
}
QMenuBar::item:selected {
    background-color: rgb(50, 50, 50);
    color: rgb(0, 255, 127);
}
QMenu {
    background-color: rgb(0, 0, 0);
    color: rgb(110, 170, 200);
}
QMenu::item:selected {
    background-color: rgb(50, 50, 50);
    color: rgb(0, 255, 127);
}
QStatusBar {
    background-color: rgb(18, 24, 30);
    color: rgb(110, 170, 200);
    border-top: 1px solid rgb(70, 100, 115);
}
QStatusBar QLabel {
    color: rgb(110, 170, 200);
    background: transparent;
    font-family: Consolas;
    font-size: 10pt;
    padding-right: 12px;
}
QSplitter#mainSplitter::handle {
    background-color: rgb(40, 55, 65);
    width: 4px;
}
QScrollArea#settingsScroll {
    background-color: rgb(0, 0, 0);
    border: none;
}
QToolButton#accordionToggle {
    background-color: rgb(12, 18, 22);
    color: rgb(110, 170, 200);
    border: 1px solid rgb(70, 100, 115);
    padding: 6px 8px;
    font-family: Consolas;
    font-size: 11pt;
    text-align: left;
}
QToolButton#accordionToggle:hover {
    border-color: rgb(0, 255, 127);
    color: rgb(160, 210, 230);
}
QToolButton#accordionToggle:checked {
    color: rgb(0, 255, 127);
    border-color: rgb(85, 135, 155);
}
QTabWidget::pane {
    border: 3px solid rgb(128, 128, 128);
    background-color: rgb(0, 0, 0);
}
QTabBar::tab {
    background-color: black;
    color: rgb(110, 170, 200);
    margin: 0px;
    padding: 6px 12px;
}
QTabBar::tab:hover {
    background-color: black;
    color: rgb(110, 170, 200);
    border: 1px solid rgb(0, 255, 0);
    margin: 0px;
    padding: 6px 12px;
}
QTabBar::tab:selected {
    background-color: black;
    color: rgb(0, 255, 127);
    border: 1px solid rgb(255, 0, 0);
    margin: 0px;
    padding: 6px 12px;
}
QToolButton {
    border: 2px solid rgb(110, 170, 200);
    color: rgb(110, 170, 200);
}
QComboBox {
    background-color: rgb(0, 0, 0);
    color: rgb(0, 255, 127);
    border: 2px solid rgb(110, 170, 200);
    padding: 4px 8px;
    min-height: 24px;
}
QComboBox:hover {
    border-color: rgb(0, 255, 127);
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border-left: 1px solid rgb(110, 170, 200);
    background: rgb(0, 30, 40);
}
QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    background-color: rgb(0, 255, 127);
}
QComboBox QAbstractItemView {
    background-color: rgb(0, 0, 0);
    color: rgb(110, 170, 200);
    selection-background-color: rgb(50, 50, 50);
    selection-color: rgb(0, 255, 127);
    border: 1px solid rgb(110, 170, 200);
}
QProgressBar {
    border-width: 3px;
    border-style: solid;
    border-color: rgb(0, 255, 127);
    color: rgb(255, 255, 255);
    background: rgb(0, 0, 0);
    text-align: center;
}
QColorDialog {
    background-color: #f0f0f0;
    color: #202020;
}
QColorDialog QWidget {
    background-color: #f0f0f0;
    color: #202020;
}
QColorDialog QLabel {
    background: transparent;
    color: #202020;
}
QColorDialog QPushButton {
    background-color: #e6e6e6;
    color: #202020;
    border: 1px solid #808080;
    min-width: 72px;
    min-height: 24px;
    padding: 4px 12px;
}
QColorDialog QPushButton:hover {
    background-color: #f4f4f4;
}
QColorDialog QSpinBox,
QColorDialog QLineEdit {
    background-color: #ffffff;
    color: #202020;
    border: 1px solid #808080;
}
QFileDialog {
    background-color: #f0f0f0;
    color: #202020;
}
QFileDialog QWidget {
    background-color: #f0f0f0;
    color: #202020;
}
QFileDialog QLabel {
    background: transparent;
    color: #202020;
}
QFileDialog QPushButton {
    background-color: #e6e6e6;
    color: #202020;
    border: 1px solid #808080;
    min-width: 72px;
    min-height: 24px;
    padding: 4px 12px;
}
QFileDialog QLineEdit,
QFileDialog QComboBox,
QFileDialog QSpinBox {
    background-color: #ffffff;
    color: #202020;
    border: 1px solid #808080;
}
QFileDialog QTreeView,
QFileDialog QListView {
    background-color: #ffffff;
    color: #202020;
    border: 1px solid #808080;
}
QPushButton#btnResetCamera,
QPushButton#btnCreate,
QPushButton#btnRecreate,
QPushButton#btnAutogen,
QPushButton#btnViewPlanet,
QPushButton#btnViewDescription,
QPushButton#btnViewSystem,
QPushButton#btnViewMap,
QPushButton#btnProgramReset,
QPushButton#btnProgramApply,
QPushButton#btnProgramCancel {
    border: 2px solid rgb(110, 170, 200);
    color: rgb(110, 170, 200);
    background-color: rgb(0, 0, 0);
    font-family: Consolas;
}
QPushButton#btnResetCamera {
    font-size: 10pt;
    min-height: 28px;
    padding: 4px 10px;
}
QPushButton#btnCreate,
QPushButton#btnRecreate,
QPushButton#btnAutogen,
QPushButton#btnProgramReset,
QPushButton#btnProgramApply,
QPushButton#btnProgramCancel {
    font-size: 18pt;
    min-height: 52px;
    padding: 8px 12px;
}
QPushButton#btnViewPlanet,
QPushButton#btnViewDescription,
QPushButton#btnViewSystem,
QPushButton#btnViewMap {
    font-size: 13pt;
    min-height: 52px;
    padding: 6px 8px;
}
QPushButton#btnProgramReset,
QPushButton#btnProgramApply,
QPushButton#btnProgramCancel {
    font-size: 12pt;
    min-height: 36px;
    padding: 6px 10px;
}
QPushButton#btnResetCamera:hover,
QPushButton#btnCreate:hover,
QPushButton#btnRecreate:hover,
QPushButton#btnAutogen:hover,
QPushButton#btnViewPlanet:hover,
QPushButton#btnViewDescription:hover,
QPushButton#btnViewSystem:hover,
QPushButton#btnViewMap:hover,
QPushButton#btnProgramReset:hover,
QPushButton#btnProgramApply:hover,
QPushButton#btnProgramCancel:hover {
    border: 2px solid rgb(145, 200, 228);
    color: rgb(160, 210, 230);
    background-color: rgb(9, 24, 31);
}
QPushButton#btnResetCamera:pressed,
QPushButton#btnCreate:pressed,
QPushButton#btnRecreate:pressed,
QPushButton#btnAutogen:pressed,
QPushButton#btnViewPlanet:pressed,
QPushButton#btnViewDescription:pressed,
QPushButton#btnViewSystem:pressed,
QPushButton#btnViewMap:pressed,
QPushButton#btnProgramReset:pressed,
QPushButton#btnProgramApply:pressed,
QPushButton#btnProgramCancel:pressed {
    border: 2px solid rgb(85, 135, 155);
    color: rgb(90, 145, 170);
    background-color: rgb(0, 0, 0);
}
QLabel#labelEmptyPreview {
    color: rgb(110, 170, 200);
}
QWidget#previewChrome {
    background-color: transparent;
}
QLabel#labelPlanetName {
    color: rgb(110, 170, 200);
    background-color: rgba(0, 0, 0, 150);
    padding: 8px 12px;
}
QWidget#cropOverlay {
    background-color: transparent;
}
QWidget#previewHud {
    background-color: rgba(0, 0, 0, 160);
}
QMessageBox {
    background-color: rgb(18, 24, 30);
    color: rgb(110, 170, 200);
}
QMessageBox QLabel {
    background: transparent;
    color: rgb(110, 170, 200);
}
QMessageBox QPushButton {
    background-color: rgb(0, 0, 0);
    color: rgb(110, 170, 200);
    border: 2px solid rgb(110, 170, 200);
    min-width: 88px;
    min-height: 28px;
    padding: 4px 12px;
    font-family: Consolas;
}
QMessageBox QPushButton:hover {
    border-color: rgb(145, 200, 228);
    color: rgb(160, 210, 230);
    background-color: rgb(9, 24, 31);
}
QMessageBox QPushButton:pressed {
    border-color: rgb(85, 135, 155);
    color: rgb(90, 145, 170);
}
QCheckBox#checkGlobeSpin,
QCheckBox#checkCropFrame,
QCheckBox#checkProgramLive {
    color: rgb(110, 170, 200);
    font-family: Consolas;
    font-size: 10pt;
    min-height: 24px;
    padding: 2px 6px;
}
QPlainTextEdit#factsCard {
    background-color: rgb(0, 0, 0);
    color: rgb(110, 170, 200);
    border: 2px solid rgb(110, 170, 200);
    font-family: Consolas;
    font-size: 10pt;
    padding: 6px;
    selection-background-color: rgb(0, 70, 70);
    selection-color: rgb(160, 210, 230);
}
